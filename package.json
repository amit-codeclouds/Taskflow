{
  "name": "taskflow",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev:shell": "npm run dev --prefix shell",
    "dev:task": "npm run dev --prefix mfe-task",
    "dev:board": "npm run start --prefix mfe-board",
    "dev": "concurrently -n shell,task,board -c blue,green,magenta \"npm run dev:shell\" \"npm run dev:task\" \"npm run dev:board\""
  },
  "overrides": {
    "enhanced-resolve": "5.17.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
